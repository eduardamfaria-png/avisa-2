rules_version = '2';
// Só a equipe do Instituto Íris lê e escreve. Ninguém mais vê nenhum dado.
service cloud.firestore {
  match /databases/{database}/documents {
    // E-mails da coordenação: sempre têm acesso e liberam os demais pelo botão "Equipe".
    function donos() { return ['eduardamfaria@gmail.com', 'ffaria.edu@gmail.com', 'albudanejoao5@gmail.com', 'phpaixaodossantos@gmail.com']; }

    function emailVerificado() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function naEquipe() {
      let acesso = /databases/$(database)/documents/config/acesso;
      return exists(acesso) && email() in get(acesso).data.emails;
    }
    function membro() { return emailVerificado() && (email() in donos() || naEquipe()); }

    match /{document=**} {
      allow read, write: if membro();
    }

    // Só a "impressão digital" dos e-mails liberados: qualquer um pode perguntar por UM
    // e-mail (para avisar antes de mandar o link), mas ninguém de fora lista ou altera.
    match /permitidos/{hash} {
      allow get: if true;
    }
  }
}
