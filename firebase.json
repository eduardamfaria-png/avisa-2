{
  "hosting": {
    "public": "site",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ] },
      { "source": "/gestao/**", "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
